@{
    ViewData["Title"] = "Nueva Contraseña";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow border-0 p-4">
        <h4 class="fw-bold text-success text-center mb-3">🔒 Ingresa tu Nueva Contraseña</h4>

        <form asp-controller="Cuenta" asp-action="RestablecerPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-bold">Nueva Contraseña</label>
                <input type="password" name="nuevaPassword" class="form-control" placeholder="Mínimo 6 caracteres" required autofocus />
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2">Guardar Contraseña</button>
        </form>
    </div>
</div>