@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow border-0 p-4">
        <h4 class="fw-bold text-success text-center mb-3">🔑 Restablecer Contraseña</h4>
        <p class="text-muted small text-center">Ingresa el correo asociado a tu cuenta para enviarte un código OTP de verificación.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center p-2 mb-3">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Cuenta" asp-action="OlvidePassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-bold">Correo Electrónico</label>
                <input type="email" name="correo" class="form-control" placeholder="tu_correo@gmail.com" required autofocus />
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2">Enviar Código de Recuperación</button>
        </form>

        <div class="text-center mt-3">
            <a asp-controller="Cuenta" asp-action="Login" class="text-secondary small fw-bold">Volver al Inicio de Sesión</a>
        </div>
    </div>
</div>