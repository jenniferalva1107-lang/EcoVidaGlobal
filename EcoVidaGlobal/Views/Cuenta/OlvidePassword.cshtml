@{
    ViewData["Title"] = "Restablecer Contraseña";
    bool pedirCorreoTemporal = ViewBag.PedirCorreoTemporal == true;
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow border-0 p-4">
        <h4 class="fw-bold text-success text-center mb-3">
            🔑 Restablecer Contraseña
        </h4>

        <p class="text-muted small text-center">
            @if (pedirCorreoTemporal)
            {
                @:La cuenta utiliza un correo de prueba. Ingresa un correo temporal para recibir el código de recuperación.
            }
            else
            {
                @:Ingresa tu código de usuario para identificar tu cuenta.
            }
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center p-2 mb-3">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Cuenta"
              asp-action="OlvidePassword"
              method="post">
            @Html.AntiForgeryToken()

            @if (pedirCorreoTemporal)
            {
                <input type="hidden"
                       name="codigoUsuario"
                       value="@ViewBag.CodigoUsuario" />

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Correo temporal
                    </label>
                    <input type="email"
                           name="correoTemporal"
                           class="form-control"
                           placeholder="tu_correo@ejemplo.com"
                           required
                           autofocus />
                </div>

                <button type="submit"
                        class="btn btn-success w-100 fw-bold py-2 mt-2">
                    Enviar código de recuperación
                </button>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Código de usuario
                    </label>
                    <input type="text"
                           name="codigoUsuario"
                           class="form-control"
                           placeholder="EVG-01"
                           required
                           autofocus
                           autocomplete="off" />
                </div>

                <button type="submit"
                        class="btn btn-success w-100 fw-bold py-2 mt-2">
                    Continuar
                </button>
            }
        </form>

        <div class="text-center mt-3">
            <a asp-controller="Cuenta"
               asp-action="Login"
               class="text-secondary small fw-bold">
                Volver al Inicio de Sesión
            </a>
        </div>
    </div>
</div>
