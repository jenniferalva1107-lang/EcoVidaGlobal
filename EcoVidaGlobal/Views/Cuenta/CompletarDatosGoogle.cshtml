@{
    ViewData["Title"] = "Completar Registro";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow border-0 p-4">
        <h4 class="fw-bold text-success text-center mb-3">📝 Datos Adicionales Requeridos</h4>
        <p class="text-muted small text-center">Para completar tu registro con Google, ingresa tu DNI y teléfono.</p>

        <form asp-action="CompletarDatosGoogle" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-bold">Número de DNI</label>
                <input type="text" name="dni" maxlength="8" class="form-control" placeholder="Ej. 72839102" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Teléfono / Celular</label>
                <input type="text" name="telefono" maxlength="9" class="form-control" placeholder="Ej. 987654321" required />
            </div>
            <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2">Finalizar Registro</button>
        </form>
    </div>
</div>