@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var usuarioNombre = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioNombre");
    var usuarioRol = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioRol");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoVidaGlobal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-success fs-4" asp-controller="Home" asp-action="Index">🌱 EcoVidaGlobal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Producto" asp-action="Index">Catálogo</a>
                        </li>
                        @if (!string.IsNullOrEmpty(usuarioNombre))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="Cuenta" asp-action="MisPedidos">📦 Mis Pedidos</a>
                            </li>
                        }
                        @if (usuarioRol == "Administrador")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Usuario" asp-action="Index">👥 Usuarios y Áreas</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(usuarioNombre))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-semibold text-success" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    👤 Hola, @usuarioNombre (@usuarioRol)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Cuenta" asp-action="Logout">Cerrar Sesión</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="Cuenta" asp-action="Login">Iniciar Sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success btn-sm ms-2 text-white fw-bold px-3" asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- WIDGET DEL CHATBOT DE ASISTENCIA ECOVIDA -->
    <div id="chat-widget" style="position: fixed; bottom: 20px; right: 20px; z-index: 1000;">
        <button onclick="toggleChat()" class="btn btn-success rounded-circle p-3 shadow-lg fs-4 border-0">💬</button>

        <div id="chat-box" class="card shadow-lg border-0 d-none mt-2" style="width: 320px; height: 400px; position: absolute; bottom: 65px; right: 0;">
            <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                <span>🌱 Asistente EcoVida</span>
                <button type="button" class="btn-close btn-close-white" onclick="toggleChat()"></button>
            </div>
            <div id="chat-body" class="card-body overflow-auto p-2" style="font-size: 14px; max-height: 290px;">
                <div class="bg-light p-2 rounded mb-2 border">¡Hola! 🌿 ¿En qué puedo ayudarte hoy? Pregúntame sobre envíos, pagos o productos.</div>
            </div>
            <div class="card-footer p-2 bg-white border-top">
                <div class="input-group">
                    <input type="text" id="chatInput" class="form-control form-control-sm" placeholder="Escribe tu mensaje..." onkeypress="if(event.key === 'Enter') enviarMensajeChat()" />
                    <button class="btn btn-success btn-sm" onclick="enviarMensajeChat()">Enviar</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-5">
        <div class="container text-center">
            &copy; 2026 - EcoVidaGlobal - <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function toggleChat() {
            document.getElementById('chat-box').classList.toggle('d-none');
        }

        function enviarMensajeChat() {
            var input = document.getElementById('chatInput');
            var txt = input.value.trim();
            if(!txt) return;

            var body = document.getElementById('chat-body');
            body.innerHTML += `<div class="bg-success text-white p-2 rounded mb-2 text-end">${txt}</div>`;
            input.value = '';

            setTimeout(() => {
                var resp = "Gracias por tu mensaje. Un asesor revisará tu consulta o puedes rastrear tu compra en la pestaña 'Mis Pedidos'.";
                if(txt.toLowerCase().includes("pago") || txt.toLowerCase().includes("yape") || txt.toLowerCase().includes("plin"))
                    resp = "Aceptamos pagos con Tarjetas, Yape y Plin con confirmación rápida.";
                if(txt.toLowerCase().includes("envio") || txt.toLowerCase().includes("mapa") || txt.toLowerCase().includes("direccion"))
                    resp = "Realizamos entregas geolocalizadas con mapa en tiempo real en todo Lima y provincias.";

                body.innerHTML += `<div class="bg-light p-2 rounded mb-2 border">🤖 ${resp}</div>`;
                body.scrollTop = body.scrollHeight;
            }, 600);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>