@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var usuarioNombre = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioNombre");
    var usuarioRol = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioRol");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoVidaGlobalDB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-success border-bottom box-shadow mb-3 navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">EcoVidaGlobalDB</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Producto" asp-action="Index">Catálogo</a>
                        </li>
                        @if (!string.IsNullOrEmpty(usuarioNombre))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-semibold" asp-controller="Cuenta" asp-action="MisPedidos">Mis Pedidos</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(usuarioNombre))
                        {
                            <li class="nav-item me-2">
                                <span class="nav-link text-warning fw-bold">👤 @usuarioNombre (@usuarioRol)</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm mt-1" asp-controller="Cuenta" asp-action="Logout">Cerrar Sesión</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm mt-1" asp-controller="Cuenta" asp-action="Login">Iniciar Sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm mt-1 text-dark fw-bold" asp-controller="Cuenta" asp-action="Registro">Registrarse</a>
                            </li>
                        }
                        <li class="nav-item ms-2">
                            <a class="btn btn-dark btn-sm mt-1 fw-bold" asp-controller="Carrito" asp-action="Index">🛒 Carrito</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto bg-white">
        <div class="container text-center">
            &copy; 2026 - EcoVidaGlobalDB
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>