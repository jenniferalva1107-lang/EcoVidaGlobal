<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Administrador EcoVidaGlobal</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            overflow-x: hidden;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #1e293b;
            color: #f8fafc;
            flex-shrink: 0;
        }

        .sidebar-scroll {
            height: calc(100vh - 120px);
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar .nav-link {
            color: #94a3b8;
            padding: 0.55rem 0.85rem;
            border-radius: 6px;
            font-size: 0.88rem;
            white-space: nowrap;
        }

            .sidebar .nav-link:hover,
            .sidebar .nav-link.active {
                background-color: #0f172a;
                color: #38bdf8;
                font-weight: 600;
            }

            .sidebar .nav-link i {
                margin-right: 8px;
                font-size: 1.05rem;
            }

        .content-area {
            flex: 1;
            padding: 25px;
            min-width: 0;
            overflow-y: auto;
        }

        .card-stat {
            border: none;
            border-radius: 10px;
            transition: transform 0.2s;
        }

            .card-stat:hover {
                transform: translateY(-3px);
            }
    </style>
</head>

<body>
    <div class="d-flex">

        <!-- MENÚ LATERAL DEL ADMINISTRADOR -->
        <div class="sidebar p-3 d-flex flex-column">

            <a href="/Admin/Dashboard"
               class="d-flex align-items-center mb-3 text-white text-decoration-none">
                <span class="fs-5 fw-bold text-success">
                    🌿 EcoVida Admin
                </span>
            </a>

            <hr class="text-secondary my-2" />

            <div class="sidebar-scroll pe-1">
                <ul class="nav nav-pills flex-column">

                    <li class="nav-item">
                        <a href="/Admin/Dashboard" class="nav-link">
                            <i class="bi bi-speedometer2"></i> Dashboard
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Usuarios" class="nav-link">
                            <i class="bi bi-people"></i> Usuarios
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Roles" class="nav-link">
                            <i class="bi bi-shield-lock"></i> Roles y permisos
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Productos" class="nav-link">
                            <i class="bi bi-box-seam"></i> Productos
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Categorias" class="nav-link">
                            <i class="bi bi-tags"></i> Categorías
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Inventario" class="nav-link">
                            <i class="bi bi-boxes"></i> Inventario
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Pedidos" class="nav-link">
                            <i class="bi bi-cart-check"></i> Pedidos
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Ventas" class="nav-link">
                            <i class="bi bi-graph-up-arrow"></i> Ventas
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Clientes" class="nav-link">
                            <i class="bi bi-person-badge"></i> Clientes
                        </a>
                    </li>

                    <li>
                        <a href="/Admin/Promociones" class="nav-link">
                            <i class="bi bi-ticket-perforated"></i> Promociones y cupones
                        </a>
                    </li>

                </ul>
            </div>

            <hr class="text-secondary my-2" />

            <a href="/Cuenta/Logout"
               class="btn btn-outline-danger btn-sm w-100">
                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
            </a>

        </div>

        <!-- ÁREA DE CONTENIDO -->
        <div class="content-area">
            @RenderBody()
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
