<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Call Center EcoVidaGlobal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
        }

        .sidebar {
            width: 260px;
            min-height: 100vh;
            background-color: #1e1b4b;
            color: #f8fafc;
        }

            .sidebar .nav-link {
                color: #c7d2fe;
                padding: 0.7rem 1rem;
                border-radius: 6px;
                font-size: 0.95rem;
                margin-bottom: 4px;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background-color: #312e81;
                    color: #ffffff;
                    font-weight: 600;
                }

                .sidebar .nav-link i {
                    margin-right: 10px;
                    font-size: 1.1rem;
                }

        .content-area {
            flex: 1;
            padding: 25px;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- MENÚ LATERAL CALL CENTER -->
        <div class="sidebar p-3 d-flex flex-column">
            <a href="/CallCenter/Dashboard" class="d-flex align-items-center mb-3 text-white text-decoration-none">
                <span class="fs-5 fw-bold text-info">🎧 Call Center EcoVida</span>
            </a>
            <hr class="text-secondary" />
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item"><a href="/CallCenter/Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li><a href="/CallCenter/BuscarCliente" class="nav-link"><i class="bi bi-search"></i> Buscar Cliente</a></li>
                <li><a href="/CallCenter/Pedidos" class="nav-link"><i class="bi bi-box-seam"></i> Consultar Pedidos</a></li>
                <li><a href="/CallCenter/Tickets" class="nav-link"><i class="bi bi-headset"></i> Tickets de Atención</a></li>
                <li><a href="/CallCenter/CrearTicket" class="nav-link"><i class="bi bi-plus-circle"></i> Nuevo Reclamo/Ticket</a></li>
            </ul>
            <hr class="text-secondary" />
            <a href="/Cuenta/Logout" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-box-arrow-right"></i> Cerrar Sesión</a>
        </div>

        <!-- ÁREA DE CONTENIDO -->
        <div class="content-area">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>