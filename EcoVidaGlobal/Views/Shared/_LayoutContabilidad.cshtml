<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Módulo Contable EcoVidaGlobal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
        }

        .sidebar {
            width: 260px;
            min-height: 100vh;
            background-color: #064e3b;
            color: #f8fafc;
        }

            .sidebar .nav-link {
                color: #a7f3d0;
                padding: 0.7rem 1rem;
                border-radius: 6px;
                font-size: 0.95rem;
                margin-bottom: 4px;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background-color: #047857;
                    color: #ffffff;
                    font-weight: 600;
                }

                .sidebar .nav-link i {
                    margin-right: 10px;
                    font-size: 1.1rem;
                }

        .content-area {
            flex: 1;
            padding: 25px;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- MENÚ LATERAL CONTABILIDAD -->
        <div class="sidebar p-3 d-flex flex-column">
            <a href="/Contabilidad/Dashboard" class="d-flex align-items-center mb-3 text-white text-decoration-none">
                <span class="fs-5 fw-bold text-warning">📊 Contabilidad EcoVida</span>
            </a>
            <hr class="text-success" />
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item"><a href="/Contabilidad/Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i> Dashboard Financiero</a></li>
                <li><a href="/Contabilidad/Ventas" class="nav-link"><i class="bi bi-receipt"></i> Ventas e Ingresos</a></li>
                <li><a href="/Contabilidad/Egresos" class="nav-link"><i class="bi bi-wallet2"></i> Egresos y Gastos</a></li>
                <li><a href="/Contabilidad/EcoBank" class="nav-link"><i class="bi bi-bank"></i> EcoBank & Conciliación</a></li>
                <li><a href="/Contabilidad/Reportes" class="nav-link"><i class="bi bi-file-earmark-bar-graph"></i> Reportes Financieros</a></li>
            </ul>
            <hr class="text-success" />
            <a href="/Cuenta/Logout" class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-box-arrow-right"></i> Cerrar Sesión</a>
        </div>

        <!-- ÁREA DE CONTENIDO -->
        <div class="content-area">
            @RenderBody()
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>