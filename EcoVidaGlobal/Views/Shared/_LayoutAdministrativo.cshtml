@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var usuarioNombre = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioNombre");
    var usuarioRol = HttpContextAccessor.HttpContext?.Session.GetString("UsuarioRol");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Panel de Control EcoVida</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #0a3622;
            color: white;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.8);
                font-weight: 500;
                margin-bottom: 4px;
                border-radius: 8px;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background-color: #198754;
                    color: white;
                }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar Lateral -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-3">
                <div class="d-flex align-items-center mb-4 text-white text-decoration-none">
                    <span class="fs-4 fw-bold text-success">🌱 EcoVida</span><span class="fs-4 text-white">Panel</span>
                </div>
                <hr class="text-white-50">
                <ul class="nav nav-pills flex-column mb-auto">
                    @if (usuarioRol == "Administrador")
                    {
                        <li class="nav-item"><a asp-controller="Usuario" asp-action="Index" class="nav-link"><i class="bi bi-people me-2"></i> Usuarios y Áreas</a></li>
                        <li class="nav-item"><a asp-controller="Producto" asp-action="Crear" class="nav-link"><i class="bi bi-box-seam me-2"></i> Nuevo Producto</a></li>
                    }
                    @if (usuarioRol == "Trabajador de Almacen" || usuarioRol == "Administrador")
                    {
                        <li class="nav-item"><a asp-controller="Producto" asp-action="Index" class="nav-link"><i class="bi bi-boxes me-2"></i> Inventario / Almacén</a></li>
                    }
                    <li class="nav-item mt-4"><a asp-controller="Producto" asp-action="Index" class="nav-link bg-outline-light"><i class="bi bi-shop me-2"></i> Ir a la Tienda</a></li>
                </ul>
                <hr class="text-white-50">
                <div class="dropdown">
                    <span class="d-block text-white fw-bold">👤 @usuarioNombre</span>
                    <small class="text-success fw-semibold">@usuarioRol</small>
                    <a asp-controller="Cuenta" asp-action="Logout" class="btn btn-sm btn-outline-danger w-100 mt-2 fw-bold">Cerrar Sesión</a>
                </div>
            </nav>

            <!-- Área Principal de Contenido -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>