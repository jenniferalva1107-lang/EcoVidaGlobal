@model IEnumerable<EcoVidaGlobal.Models.CarritoItem>

@{
    ViewData["Title"] = "Carrito de Compras";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    decimal subtotal = Model.Sum(i => (i.Producto?.Precio ?? 0) * i.Cantidad);
    decimal costoEnvio = subtotal > 0 ? 12.00m : 0.00m;
    decimal total = subtotal + costoEnvio;
}

<div class="container py-4">
    <!-- TÍTULO DE LA PÁGINA -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <span class="badge bg-success-subtle text-success border border-success fw-bold px-3 py-1 rounded-pill mb-2">
                🛒 Paso 1 de 3
            </span>
            <h2 class="fw-bold text-success mb-0">Carrito de Compras</h2>
        </div>
        <a asp-controller="Producto" asp-action="Index" class="btn btn-outline-success btn-sm fw-bold rounded-3">
            ← Seguir Comprando
        </a>
    </div>

    @if (!Model.Any())
    {
        <!-- CARRITO VACÍO -->
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white my-4">
            <div class="display-1 text-muted mb-3">🛒</div>
            <h4 class="fw-bold text-dark mb-2">Tu carrito está vacío</h4>
            <p class="text-muted mb-4">Parece que aún no has agregado ningún producto sostenible a tu carrito.</p>
            <div>
                <a asp-controller="Producto" asp-action="Index" class="btn btn-success fw-bold px-4 py-2 rounded-3">
                    Explorar el Catálogo
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- LISTA DE PRODUCTOS Y RESUMEN DE COMPRA -->
        <div class="row g-4">

            <!-- LISTA DE ITEMS -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-3">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold mb-0 text-success">Productos Seleccionados (@Model.Sum(i => i.Cantidad))</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-muted small fw-bold">
                                    <tr>
                                        <th class="ps-4">Producto</th>
                                        <th class="text-center">Precio</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-end">Subtotal</th>
                                        <th class="text-center pe-4">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        decimal itemSubtotal = (item.Producto?.Precio ?? 0) * item.Cantidad;
                                        <tr>
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    <img src="@(string.IsNullOrEmpty(item.Producto?.ImagenUrl) ? "/images/producto-placeholder.jpg" : item.Producto.ImagenUrl)"
                                                         class="rounded-3 me-3" style="width: 50px; height: 50px; object-fit: contain;"
                                                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=400&q=80';" />
                                                    <div>
                                                        <h6 class="fw-bold mb-0 text-dark">@(item.Producto?.Nombre ?? "Producto")</h6>
                                                        <small class="text-muted">Stock: @(item.Producto?.Stock ?? 0)</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-semibold text-dark">
                                                S/ @((item.Producto?.Precio ?? 0).ToString("F2"))
                                            </td>
                                            <td class="text-center" style="width: 130px;">
                                                <form asp-controller="Carrito" asp-action="ActualizarCantidad" method="post" class="d-flex align-items-center justify-content-center">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="carritoItemId" value="@item.CarritoItemID" />
                                                    <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="@(item.Producto?.Stock ?? 99)"
                                                           class="form-control form-control-sm text-center fw-bold me-1" style="width: 60px;"
                                                           onchange="this.form.submit()" />
                                                </form>
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                S/ @itemSubtotal.ToString("F2")
                                            </td>
                                            <td class="text-center pe-4">
                                                <form asp-controller="Carrito" asp-action="Eliminar" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productoId" value="@item.ProductoID" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm rounded-circle p-1"
                                                            title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RESUMEN DEL PEDIDO -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                    <h5 class="fw-bold text-success mb-3">Resumen de la Compra</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold text-dark">S/ @subtotal.ToString("F2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Envío Estimado</span>
                        <span class="fw-bold text-dark">S/ @costoEnvio.ToString("F2")</span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold text-dark">Total</span>
                        <span class="fs-4 fw-bold text-success">S/ @total.ToString("F2")</span>
                    </div>

                    <!-- BOTÓN CORREGIDO RUTA /Carrito/Checkout -->
                    <a asp-controller="Carrito" asp-action="Checkout" class="btn btn-success w-100 fw-bold py-2 rounded-3 shadow-sm">
                        Continuar a Dirección de Entrega →
                    </a>

                    <div class="mt-3 text-center">
                        <small class="text-muted d-block"><i class="bi bi-shield-check text-success me-1"></i> Compra 100% Segura y Ecológica</small>
                    </div>
                </div>
            </div>

        </div>
    }
</div>