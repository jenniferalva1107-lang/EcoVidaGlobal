@model EcoVidaGlobal.Models.Pedido

@{
    ViewData["Title"] = "Pedido Confirmado - EcoVidaGlobal";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-4 p-md-5 mx-auto rounded-4 bg-white" style="max-width: 650px;">
        <div class="mb-3">
            <span class="display-1">🎉</span>
        </div>
        <h2 class="text-success fw-bold">¡Gracias por tu compra eco-amigable!</h2>
        <p class="lead text-dark">Tu pedido <strong class="text-success">#@Model.PedidoID</strong> se ha registrado con éxito.</p>

        <hr class="my-4" />

        <div class="text-start bg-light p-3 rounded-3 mb-4">
            <h6 class="fw-bold text-success mb-3">Detalles de la Entrega:</h6>
            <p class="mb-1"><strong>Fecha:</strong> @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</p>
            <p class="mb-1"><strong>Dirección:</strong> @Model.DireccionEnvio, @Model.Ciudad</p>
            <p class="mb-1"><strong>Teléfono:</strong> @Model.TelefonoContacto</p>
            <p class="mb-1"><strong>Método de Pago:</strong> @Model.MetodoPago</p>
            <p class="mb-0"><strong>Monto Total:</strong> <span class="text-success fw-bold">S/ @Model.Total.ToString("F2")</span></p>
        </div>

        <div>
            <a asp-controller="Producto" asp-action="Index" class="btn btn-success fw-bold px-4 py-2 rounded-3">
                Volver a la Tienda
            </a>
        </div>
    </div>
</div>