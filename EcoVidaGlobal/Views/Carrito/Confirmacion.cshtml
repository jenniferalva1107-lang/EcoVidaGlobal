@model EcoVidaGlobal.Models.Pedido

@{
    ViewData["Title"] = "Confirmación de Pedido";
}

<div class="container mt-5" style="max-width: 650px;">
    <div class="card shadow border-0 p-4 text-center">
        <div class="mb-3 text-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
        </div>

        <h2 class="fw-bold text-success">¡Compra Realizada con Éxito!</h2>
        <p class="text-muted">Tu pedido <strong>#@Model.PedidoID</strong> ha sido registrado en el sistema.</p>

        <!-- Datos del Cliente -->
        <div class="card bg-white border p-3 text-start mb-3 shadow-sm">
            <h6 class="fw-bold text-success border-bottom pb-2 mb-2">👤 Datos del Comprador</h6>
            <div class="row small">
                <div class="col-6 mb-1"><strong>Cliente:</strong> @Model.Usuario?.NombreCompleto</div>
                <div class="col-6 mb-1"><strong>Correo:</strong> @Model.Usuario?.Correo</div>
                <div class="col-6"><strong>DNI:</strong> @(string.IsNullOrEmpty(Model.Usuario?.DNI) ? "No especificado" : Model.Usuario.DNI)</div>
                <div class="col-6"><strong>Teléfono:</strong> @(string.IsNullOrEmpty(Model.Usuario?.Telefono) ? "No especificado" : Model.Usuario.Telefono)</div>
            </div>
        </div>

        <!-- Resumen del Pedido -->
        <div class="card bg-light border-0 mb-3 p-3 text-start">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">🧾 Resumen del Pedido</h6>
            <div class="d-flex justify-content-between small text-muted mb-2">
                <span>Fecha:</span>
                <span>@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="d-flex justify-content-between small text-muted mb-3">
                <span>Estado:</span>
                <span class="badge bg-success">@Model.Estado</span>
            </div>

            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-center">Cant.</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>@d.Producto?.Nombre</td>
                            <td class="text-center">@d.Cantidad</td>
                            <td class="text-end">S/ @((d.PrecioUnitario * d.Cantidad).ToString("F2"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-between fs-5 fw-bold text-success pt-2 border-top">
                <span>Total Pagado:</span>
                <span>S/ @Model.Total.ToString("F2")</span>
            </div>
        </div>

        <a asp-controller="Producto" asp-action="Index" class="btn btn-success fw-bold py-2 mt-2">
            Volver al Catálogo
        </a>
    </div>
</div>