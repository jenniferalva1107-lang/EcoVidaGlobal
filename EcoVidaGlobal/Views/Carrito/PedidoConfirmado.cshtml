@{
    ViewData["Title"] = "¡Pedido Confirmado!";
}

<div class="container my-5 py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 text-center bg-white">

                <!-- ÍCONO DE CHECK VERDE -->
                <div class="d-flex justify-content-center mb-4">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                         style="width: 100px; height: 100px; background-color: #d1e7dd; border: 4px solid #198754;">
                        <span style="font-size: 50px; color: #198754; font-weight: bold; line-height: 1;">✓</span>
                    </div>
                </div>

                <!-- TÍTULO Y MENSAJE PRINCIPAL -->
                <h2 class="fw-bold text-success mb-2">¡Pedido confirmado!</h2>
                <p class="fs-5 text-secondary mb-4">Tu pedido ha sido registrado correctamente.</p>

                <!-- CÓDIGO DE PEDIDO Y NOTIFICACIÓN -->
                <div class="bg-light p-3 rounded-3 mb-4 border border-1">
                    <div class="text-muted small text-uppercase fw-bold tracking-wide mb-1">Número de Pedido</div>
                    <div class="fs-4 fw-bold text-dark mb-2" style="letter-spacing: 1px;">EV-2026-000001</div>
                    <p class="text-muted mb-0 small">
                        ✉️ Te hemos enviado un correo electrónico con los detalles y la confirmación de tu compra.
                    </p>
                </div>

                <!-- BOTONES DE ACCIÓN -->
                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                    <a asp-controller="Cuenta" asp-action="MisPedidos" class="btn btn-success btn-lg fw-bold px-4 py-2 rounded-3 shadow-sm" style="background-color: #0f8b4c; border-color: #0f8b4c;">
                        📋 Ver mi pedido
                    </a>
                    <a asp-controller="Producto" asp-action="Index" class="btn btn-outline-success btn-lg fw-bold px-4 py-2 rounded-3">
                        🛍️ Seguir comprando
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>