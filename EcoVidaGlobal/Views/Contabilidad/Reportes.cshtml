@{
    Layout = "~/Views/Shared/_LayoutContabilidad.cshtml";
    ViewData["Title"] = "Reportes Financieros";
}

<h3 class="fw-bold mb-4"><i class="bi bi-file-earmark-bar-graph text-dark me-2"></i>Reportes Financieros Exportables</h3>

<div class="card p-4 shadow-sm border-0 bg-white">
    <h5 class="fw-bold mb-3">Descarga de Libros Contables</h5>
    <div class="d-flex gap-3">
        <a asp-controller="Contabilidad"
           asp-action="ExportarLibroDiario"
           class="btn btn-outline-success fw-bold">
            <i class="bi bi-file-earmark-excel me-1"></i>
            Libro Diario (.XLSX)
        </a>

        <a asp-controller="Contabilidad"
           asp-action="ExportarEstadoResultadosPdf"
           class="btn btn-outline-danger fw-bold">
            <i class="bi bi-file-earmark-pdf me-1"></i>
            Estado de Ganancias y Pérdidas (.PDF)
        </a>

    </div>
</div>