@{
    Layout = "~/Views/Shared/_LayoutContabilidad.cshtml";
    ViewData["Title"] = "EcoBank & Conciliación";
}

<h3 class="fw-bold mb-4"><i class="bi bi-bank text-primary me-2"></i>EcoBank - Módulo de Conciliación Bancaria</h3>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 shadow-sm border-0 bg-white border-start border-4 border-success">
            <small class="text-muted fw-bold">SALDO EN CAJA GENERAL</small>
            <h3 class="fw-bold text-success mt-1">S/ @ViewBag.SaldoCaja.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow-sm border-0 bg-white border-start border-4 border-primary">
            <small class="text-muted fw-bold">CUENTA BCP (60%)</small>
            <h3 class="fw-bold text-primary mt-1">S/ @ViewBag.BancoBcp.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow-sm border-0 bg-white border-start border-4 border-info">
            <small class="text-muted fw-bold">CUENTA BBVA (40%)</small>
            <h3 class="fw-bold text-info mt-1">S/ @ViewBag.BancoBva.ToString("N2")</h3>
        </div>
    </div>
</div>

<div class="card p-4 shadow-sm border-0 bg-white">
    <h5 class="fw-bold mb-3">Conciliación de Pagos Simulados</h5>
    <p class="text-muted">Las transferencias y cobros vía Yape/Plin son conciliados automáticamente en tiempo real.</p>
</div>