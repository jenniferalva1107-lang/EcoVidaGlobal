@model IEnumerable<EcoVidaGlobal.Models.Producto>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; ViewData["Title"] = "Productos";
}

<h3 class="fw-bold mb-4 text-dark"><i class="bi bi-box-seam text-success me-2"></i>Catálogo de Productos</h3>

<div class="card p-4 shadow-sm border-0 rounded-3 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.ProductoID</td>
                        <td class="fw-bold">@p.Nombre</td>
                        <td>@(p.Categoria?.Nombre ?? "General")</td>
                        <td class="text-success fw-bold">S/ @p.Precio.ToString("F2")</td>
                        <td><span class="badge @(p.Stock <= 5 ? "bg-danger" : "bg-success")">@p.Stock unids</span></td>
                        <td>
                            @if (p.Stock > 0)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Agotado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>