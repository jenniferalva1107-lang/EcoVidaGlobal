@model IEnumerable<EcoVidaGlobal.Models.Usuario>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; ViewData["Title"] = "Clientes";
}

<h3 class="fw-bold mb-4 text-dark"><i class="bi bi-person-badge text-success me-2"></i>Directorio de Clientes</h3>

<div class="card p-4 shadow-sm border-0 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Puntos Acumulados</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.UsuarioID</td>
                        <td class="fw-bold">@c.NombreCompleto</td>
                        <td>@c.Correo</td>
                        <td>@(c.Telefono ?? "Sin registro")</td>
                        <td><span class="badge bg-success">@c.PuntosAcumulados pts</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>