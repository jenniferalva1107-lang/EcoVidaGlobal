@model EcoVidaGlobal.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0 p-4">
        <h3 class="fw-bold text-success mb-3">📦 Nuevo Producto</h3>

        <form asp-action="Crear" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-bold"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoriaID" class="form-label fw-bold">Categoría</label>
                <select asp-for="CategoriaID" asp-items="ViewBag.Categorias" class="form-select">
                    <option value="">-- Selecciona una Categoría --</option>
                </select>
                <span asp-validation-for="CategoriaID" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Precio" class="form-label fw-bold"></label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Stock" class="form-label fw-bold"></label>
                    <input asp-for="Stock" type="number" class="form-control" />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label fw-bold"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-4">
                <label asp-for="ImagenArchivo" class="form-label fw-bold"></label>
                <input asp-for="ImagenArchivo" type="file" class="form-control" accept="image/*" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success fw-bold flex-grow-1">Guardar Producto</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>