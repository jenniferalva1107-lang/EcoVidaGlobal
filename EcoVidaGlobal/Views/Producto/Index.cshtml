@model IEnumerable<EcoVidaGlobal.Models.Producto>

@{
    string catSeleccionada = ViewBag.CategoriaSeleccionada as string ?? "Todas";

    ViewData["Title"] = catSeleccionada == "Todas"
        ? "Catálogo Completo"
        : "Categoría: " + catSeleccionada;

    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<!-- ENCABEZADO DEL CATÁLOGO -->
<div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border mb-4">
    <div class="row align-items-center">
        <div class="col-md-8">
            <span class="badge bg-success-subtle text-success border border-success fw-bold px-3 py-1 rounded-pill mb-2">
                🛍️ Catálogo EcoVida Enterprise
            </span>

            <h1 class="fw-bold text-success mb-2">
                @(catSeleccionada == "Todas" ? "Catálogo Sostenible Completo" : catSeleccionada)
            </h1>

            <p class="text-muted mb-0">
                Explora nuestra selección de alternativas ecológicas libres de plásticos.
            </p>
        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">
                📦 @Model.Count() Productos
            </span>
        </div>
    </div>
</div>

<!-- BARRA DE BÚSQUEDA Y FILTROS -->
<div class="card border-0 shadow-sm p-3 mb-4 rounded-4 bg-white">
    <div class="row g-3 align-items-center">
        <div class="col-md-6 col-lg-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       id="buscadorInput"
                       class="form-control bg-light border-start-0"
                       placeholder="Buscar producto por nombre..."
                       oninput="filtrarProductos()" />
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="d-flex flex-wrap gap-1">
                <a asp-controller="Producto"
                   asp-action="Index"
                   class="btn btn-sm @(catSeleccionada == "Todas" ? "btn-success fw-bold" : "btn-outline-success") rounded-pill">
                    Todas
                </a>

                <a asp-controller="Producto"
                   asp-action="PorCategoria"
                   asp-route-nombreCategoria="Cuidado Personal"
                   class="btn btn-sm @(catSeleccionada.Equals("Cuidado Personal", StringComparison.OrdinalIgnoreCase) ? "btn-success fw-bold" : "btn-outline-success") rounded-pill">
                    🌱 Cuidado Personal
                </a>

                <a asp-controller="Producto"
                   asp-action="PorCategoria"
                   asp-route-nombreCategoria="Hogar Sostenible"
                   class="btn btn-sm @(catSeleccionada.Equals("Hogar Sostenible", StringComparison.OrdinalIgnoreCase) ? "btn-success fw-bold" : "btn-outline-success") rounded-pill">
                    🏡 Hogar Sostenible
                </a>

                <a asp-controller="Producto"
                   asp-action="PorCategoria"
                   asp-route-nombreCategoria="Reutilizables"
                   class="btn btn-sm @(catSeleccionada.Equals("Reutilizables", StringComparison.OrdinalIgnoreCase) ? "btn-success fw-bold" : "btn-outline-success") rounded-pill">
                    ♻️ Reutilizables
                </a>
            </div>
        </div>

        <div class="col-md-12 col-lg-3 text-lg-end">
            <select id="ordenarPrecio"
                    class="form-select bg-light"
                    onchange="ordenarProductos()">
                <option value="default">Ordenar por...</option>
                <option value="menor">Precio: Menor a Mayor</option>
                <option value="mayor">Precio: Mayor a Menor</option>
            </select>
        </div>
    </div>
</div>

<!-- GRILLA DE PRODUCTOS -->
@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center rounded-4 my-4 bg-white">
        <div class="fs-1 mb-2">🍃</div>
        <h4 class="fw-bold text-dark mb-2">No se encontraron productos</h4>
        <p class="text-muted">Aún no hay productos registrados para esta sección.</p>

        <div>
            <a asp-controller="Producto"
               asp-action="Index"
               class="btn btn-success fw-bold rounded-3 mt-2">
                Ver Todo el Catálogo
            </a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4"
         id="grillaProductos">

        @foreach (var item in Model)
        {
            bool agotado = item.Stock <= 0;

            <div class="col tarjeta-item"
                 data-nombre="@item.Nombre.ToLowerInvariant()"
                 data-precio="@item.Precio"
                 data-stock="@item.Stock">

                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative bg-white">

                    <!-- CATEGORÍA -->
                    <span class="position-absolute top-0 start-0 bg-success text-white px-2 py-1 m-2 rounded-pill small fw-bold"
                          style="z-index:2; font-size:0.75rem;">
                        @(item.Categoria?.Nombre ?? "Ecológico")
                    </span>


                    <!-- IMAGEN DEL PRODUCTO -->
                    <div class="bg-light text-center p-3 position-relative d-flex align-items-center justify-content-center"
                         style="height: 220px; overflow: hidden;">

                        <img src="@(string.IsNullOrWhiteSpace(item.ImagenUrl) ? "/images/producto-placeholder.jpg" : item.ImagenUrl)"
                             class="img-fluid"
                             style="width: 100%; height: 190px; object-fit: contain; display: block;"
                             alt="@item.Nombre"
                             loading="lazy"
                             onerror="this.onerror=null; this.src='/images/producto-placeholder.jpg';" />

                        @if (agotado)
                        {
                            <span class="position-absolute bottom-0 end-0 badge bg-danger m-2 fs-6">
                                AGOTADO
                            </span>
                        }
                    </div>

                    <!-- INFORMACIÓN DEL PRODUCTO -->
                    <div class="card-body d-flex flex-column p-3">

                        <h6 class="fw-bold text-dark mb-1 text-truncate"
                            title="@item.Nombre">
                            @item.Nombre
                        </h6>

                        <p class="text-muted small mb-2 flex-grow-1"
                           style="font-size:0.825rem; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                            @item.Descripcion
                        </p>

                        <div class="d-flex align-items-center justify-content-between my-2">
                            <span class="fs-5 fw-bold text-success">
                                S/ @item.Precio.ToString("F2")
                            </span>

                            @if (agotado)
                            {
                                <small class="text-danger fw-bold">Sin stock</small>
                            }
                            else
                            {
                                <small class="text-muted fw-semibold">
                                    Stock: @item.Stock
                                </small>
                            }
                        </div>

                        <!-- ACCIONES -->
                        <div class="d-grid gap-2 mt-auto">

                            <button type="button"
                                    class="btn btn-outline-success btn-sm fw-bold rounded-3"
                                    onclick="abrirModalDetalle(this)"
                                    data-nombre="@item.Nombre"
                                    data-precio="@item.Precio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                    data-stock="@item.Stock"
                                    data-descripcion="@item.Descripcion"
                                    data-imagen="@item.ImagenUrl"
                                    data-categoria="@(item.Categoria?.Nombre ?? "Ecológico")">
                                🔍 Ver Detalle
                            </button>

                            @if (!agotado)
                            {
                                <form asp-controller="Carrito"
                                      asp-action="Agregar"
                                      method="post"
                                      class="d-grid">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productoId"
                                           value="@item.ProductoID" />

                                    <input type="hidden"
                                           name="cantidad"
                                           value="1" />

                                    <button type="submit"
                                            class="btn btn-success btn-sm fw-bold shadow-sm rounded-3">
                                        🛒 Agregar al Carrito
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary btn-sm fw-bold rounded-3"
                                        disabled
                                        aria-disabled="true">
                                    <i class="bi bi-x-circle"></i> Producto Agotado
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="mensajeSinResultados"
         class="alert alert-light border text-center mt-4 d-none">
        No hay productos que coincidan con tu búsqueda.
    </div>
}

<!-- MODAL DETALLE RÁPIDO -->
<div class="modal fade"
     id="modalDetalleProducto"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="modalNombre">
                    Detalle del Producto
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-4 align-items-center">

                    <div class="col-md-5 text-center bg-light p-3 rounded-3">
                        <img id="modalImagen"
                             src=""
                             class="img-fluid rounded"
                             style="max-height:250px; object-fit:contain;"
                             alt="Producto" />
                    </div>

                    <div class="col-md-7">
                        <span id="modalCategoria"
                              class="badge bg-success-subtle text-success border border-success fw-bold px-2 py-1 mb-2">
                        </span>

                        <h4 id="modalTitulo" class="fw-bold text-dark mb-2"></h4>

                        <h3 id="modalPrecio" class="fw-bold text-success mb-3"></h3>

                        <p id="modalDescripcion" class="text-muted small mb-3"></p>

                        <div class="bg-light p-3 rounded mb-3">
                            <small class="text-muted d-block fw-bold">
                                Stock Disponible
                            </small>

                            <span id="modalStock" class="fw-bold text-dark fs-6"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 bg-light">
                <button type="button"
                        class="btn btn-secondary fw-bold rounded-3"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModalDetalle(boton) {
            const nombre = boton.dataset.nombre || "Producto";
            const precio = boton.dataset.precio || "0.00";
            const stock = Number(boton.dataset.stock || 0);
            const descripcion = boton.dataset.descripcion || "";
            const imagenUrl = boton.dataset.imagen || "";
            const categoria = boton.dataset.categoria || "Ecológico";

            document.getElementById("modalNombre").innerText = nombre;
            document.getElementById("modalTitulo").innerText = nombre;
            document.getElementById("modalPrecio").innerText = "S/ " + precio;
            document.getElementById("modalStock").innerText =
                stock > 0 ? stock + " unidades disponibles" : "Agotado";

            document.getElementById("modalStock").className =
                stock > 0
                    ? "fw-bold text-success fs-6"
                    : "fw-bold text-danger fs-6";

            document.getElementById("modalDescripcion").innerText =
                descripcion || "Producto sostenible elaborado con insumos naturales.";

            document.getElementById("modalCategoria").innerText = categoria;

            const imagen = document.getElementById("modalImagen");
            imagen.onerror = function () {
                this.onerror = null;
                this.src = "/images/producto-placeholder.jpg";
            };
            imagen.src = imagenUrl || "/images/producto-placeholder.jpg";

            const modal = bootstrap.Modal.getOrCreateInstance(
                document.getElementById("modalDetalleProducto")
            );

            modal.show();
        }

        function filtrarProductos() {
            const texto = document.getElementById("buscadorInput")
                .value.trim().toLocaleLowerCase();

            const tarjetas = document.querySelectorAll(".tarjeta-item");
            let visibles = 0;

            tarjetas.forEach(function (tarjeta) {
                const nombre = tarjeta.dataset.nombre || "";
                const coincide = nombre.includes(texto);

                tarjeta.classList.toggle("d-none", !coincide);

                if (coincide) {
                    visibles++;
                }
            });

            const mensaje = document.getElementById("mensajeSinResultados");

            if (mensaje) {
                mensaje.classList.toggle("d-none", visibles !== 0);
            }
        }

        function ordenarProductos() {
            const criterio = document.getElementById("ordenarPrecio").value;
            const contenedor = document.getElementById("grillaProductos");

            if (!contenedor || criterio === "default") {
                return;
            }

            const tarjetas = Array.from(
                contenedor.querySelectorAll(".tarjeta-item")
            );

            tarjetas.sort(function (a, b) {
                const precioA = Number(a.dataset.precio || 0);
                const precioB = Number(b.dataset.precio || 0);

                return criterio === "menor"
                    ? precioA - precioB
                    : precioB - precioA;
            });

            tarjetas.forEach(function (tarjeta) {
                contenedor.appendChild(tarjeta);
            });
        }
    </script>
}