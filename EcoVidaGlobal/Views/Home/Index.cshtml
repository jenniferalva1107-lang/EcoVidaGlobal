@model IEnumerable<EcoVidaGlobal.Models.Producto>

@{
    ViewData["Title"] = "Inicio - Productos Ecológicos & Sustentables";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<!-- HERO BANNER PRINCIPAL -->
<div class="position-relative text-white text-center py-5 rounded-4 overflow-hidden mb-5" style="background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; min-height: 420px; display: flex; align-items: center; justify-content: center;">
    <div class="container">
        <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3">🌱 100% Sostenible</span>
        <h1 class="display-4 fw-bold mb-3">Vive de forma consciente y sostenible</h1>
        <p class="fs-5 text-light max-w-600 mx-auto mb-4">Descubre nuestra línea de productos 100% biodegradables y libres de plástico.</p>
        <a asp-controller="Producto" asp-action="Index" class="btn btn-warning fw-bold px-4 py-2 fs-6 shadow-sm text-dark rounded-3">
            Explorar Catálogo Completo
        </a>
    </div>
</div>

<!-- ¿POR QUÉ ELEGIR ECOVIDA? (BENEFICIOS RÁPIDOS) -->
<section class="py-4 bg-white rounded-4 shadow-sm mb-5">
    <div class="container">
        <h3 class="text-center fw-bold text-success mb-4">¿Por qué elegir EcoVida?</h3>
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <i class="bi bi-recycle text-success display-5 mb-2 d-block"></i>
                <h6 class="fw-bold mb-0">100% Biodegradable</h6>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-truck text-success display-5 mb-2 d-block"></i>
                <h6 class="fw-bold mb-0">Envíos Neutros</h6>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-people-fill text-success display-5 mb-2 d-block"></i>
                <h6 class="fw-bold mb-0">Comercio Justo</h6>
            </div>
            <div class="col-6 col-md-3">
                <i class="bi bi-box-seam text-success display-5 mb-2 d-block"></i>
                <h6 class="fw-bold mb-0">Zero Waste</h6>
            </div>
        </div>
    </div>
</section>

<!-- SECCIÓN DE PRODUCTOS DESTACADOS -->
<section class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-success mb-0">🌟 Productos Destacados</h3>
            <p class="text-muted small mb-0">Los preferidos por nuestra comunidad ecológica</p>
        </div>
        <a asp-controller="Producto" asp-action="Index" class="btn btn-outline-success btn-sm fw-bold rounded-3">
            Ver Todos →
        </a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="bg-light text-center p-3" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                        <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "/images/producto-placeholder.jpg" : item.ImagenUrl)"
                             class="img-fluid"
                             style="max-height: 150px; object-fit: contain;"
                             alt="@item.Nombre"
                             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=400&q=80';" />
                    </div>
                    <div class="card-body d-flex flex-column p-3">
                        <span class="badge bg-success-subtle text-success fw-bold me-auto mb-2" style="font-size: 0.75rem;">
                            @(item.Categoria?.Nombre ?? "Ecológico")
                        </span>
                        <h6 class="fw-bold text-dark mb-1 text-truncate">@item.Nombre</h6>
                        <div class="d-flex align-items-center justify-content-between mt-auto pt-2">
                            <span class="fs-5 fw-bold text-success">S/ @item.Precio.ToString("F2")</span>
                            <a asp-controller="Producto" asp-action="Index" class="btn btn-success btn-sm fw-bold rounded-3">
                                Comprar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>