@model EcoVidaGlobal.Models.Usuario

@{
    ViewData["Title"] = "Editar Permisos de Usuario";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-0 p-4">
        <h4 class="fw-bold text-success mb-3">✏️ Editar Permisos y Área de Usuario</h4>

        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UsuarioID" />

            <div class="mb-3">
                <label class="form-label fw-bold">Nombre Completo</label>
                <input asp-for="NombreCompleto" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Correo Electrónico</label>
                <input asp-for="Correo" type="email" class="form-control" required />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">DNI</label>
                    <input asp-for="DNI" class="form-control" maxlength="8" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" maxlength="9" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Área / Rol Asignado</label>
                <select asp-for="RolID" asp-items="ViewBag.Roles" class="form-select" required></select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Estado de Cuenta</label>
                <select asp-for="EstadoCuenta" class="form-select">
                    <option value="Activo">Activo</option>
                    <option value="Inactivo">Inactivo / Suspendido</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success fw-bold flex-grow-1">Actualizar Permisos</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>