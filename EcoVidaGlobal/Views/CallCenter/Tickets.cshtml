<script>
    function resolverTicket(id) {
        if (confirm('¿Deseas marcar el ticket #TK-2026-' + id + ' como RESUELTO?')) {
            var fila = document.getElementById('ticket-' + id);
            if (fila) {
                fila.style.display = 'none';
                alert('Ticket #TK-2026-' + id + ' marcado como Resuelto correctamente.');
            }
        }
    }

    // Activar pestaña según el parámetro URL (Ej: /CallCenter/Tickets?estado=resueltos)
    document.addEventListener("DOMContentLoaded", function () {
        var urlParams = new URLSearchParams(window.location.search);
        var estado = urlParams.get('estado');

        if (estado === 'resueltos') {
            var tab = new bootstrap.Tab(document.getElementById('pills-resueltos-tab'));
            tab.show();
        } else if (estado === 'pendientes') {
            var tab = new bootstrap.Tab(document.getElementById('pills-pendientes-tab'));
            tab.show();
        }
    });
</script>